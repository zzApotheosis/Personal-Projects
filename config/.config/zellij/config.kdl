//default_mode "locked"
default_shell "nu"

keybinds {
    unbind "Ctrl b"

    normal {
        bind "`" {
            SwitchToMode "Tmux";
        }
    }

    tmux {
        bind "`" {
            WriteChars "`";
            SwitchToMode "Normal";
        }
    }

    locked {
        unbind "Ctrl g"
        bind "Alt Backspace" {
            SwitchToMode "Normal";
        }
    }
}
