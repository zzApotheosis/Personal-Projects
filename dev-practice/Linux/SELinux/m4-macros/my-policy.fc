# Label the executable (e.g., if placed in /usr/bin or a home directory)
#/usr/bin/my_custom_app       -- gen_context(system_u:object_r:my_type_exec_t,s0)
/usr/local/bin/my-custom-app       -- gen_context(system_u:object_r:my_type_exec_t,s0)

# Label the data directory and everything inside it
/var/lib/my-custom-app(/.*)?    gen_context(system_u:object_r:my_type_data_t,s0)
