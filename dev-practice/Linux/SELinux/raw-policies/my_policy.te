# 1. Declare the policy module and version
module my_policy 1.0;

# 2. Require the core classes and permissions from the kernel
# Since we aren't using macros, we must explicitly state what we are using.
require {
    type unconfined_t;
    class process { transition sigchld };
    class dir { read write search add_name remove_name };
    class file { execute read write open getattr create setattr unlink entrypoint };
}

# 3. Define the Types
type my_type_t;
type my_type_exec_t;
type my_type_data_t;

# 4. Domain Transition Setup
# Allow a process (e.g., init or unconfined_t) to execute the binary
allow unconfined_t my_type_exec_t : file { read execute open };

# Tell the kernel that executing my_type_exec_t transitions the process to my_type_t
type_transition unconfined_t my_type_exec_t : process my_type_t;

# Allow the actual transition to happen
allow unconfined_t my_type_t : process transition;
allow my_type_t my_type_exec_t : file entrypoint;

# 5. Restrict my_type_t to ONLY my_type_data_t
# Grant full access to files of type my_type_data_t
allow my_type_t my_type_data_t : file { read write open getattr create setattr unlink };

# Grant full access to directories of type my_type_data_t (so it can manage files inside)
allow my_type_t my_type_data_t : dir { read write search add_name remove_name };

# Allow the child domain to communicate back to its parent descriptor if needed
allow my_type_t unconfined_t : process sigchld;


