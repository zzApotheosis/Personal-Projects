{
  "app-id": "io.example.my-app",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "my-app",
  "modules": [
    {
      "name": "my-module",
      "buildsystem": "meson",
      "config-opts": [
        "-Dprefix=/app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "my-app"
        }
      ],
      "dependencies": [
        "pkg-config",
        "meson"
      ]
    }
  ]
}
